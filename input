#------------------------------------------
# Sample vampire input file to perform
# a Curie temperature simulation for Ni.
# Provided as part of the 2019 Vampire 
# Workshop.
# This file is left incomplete as an
# exercise, try to choose some reasonable
# parameters based on 1a_Ni
#------------------------------------------

#------------------------------------------
# Creation attributes:
#------------------------------------------
#create:crystal-structure=fcc

#------------------------------------------
# System Dimensions:
#------------------------------------------
dimensions:unit-cell-size = 3.524 !A
dimensions:system-size-x = 6 !nm
dimensions:system-size-y = 6 !nm
dimensions:system-size-z = 6 !nm

#------------------------------------------
# Material Files:
#------------------------------------------
material:file=Ni.mat
material:unit-cell-file = file.ucl

#------------------------------------------
# Simulation attributes:
#------------------------------------------

#sim:minimum-temperature=0.2
#sim:maximum-temperature=1000
#sim:temperature-increment=25
#sim:temperature = 25
sim:loop-time-steps= 1000000
sim:equilibration-time-steps= 1000000
#sim:loop-time-steps= 1000
sim:time-step=1.0E-16

#------------------------------------------
# Program and integrator details
#------------------------------------------
#sim:program=curie-temperature
#sim: program = time-series
sim:integrator=monte-carlo
sim:program=curie-temperature

sim:minimum-temperature=25.2

sim:maximum-temperature=125.2

sim:temperature-increment=5

montecarlo:algorithm = local-quantized
montecarlo:spin-quantum-number = 1.0

montecarlo:enable-collective-moves
montecarlo:collective-move-probability = 0.005
montecarlo:collective-move-amplitude = 0.01
montecarlo:collective-move-qmax = 1

#------------------------------------------
# data output
#------------------------------------------
output:real-time
output:temperature
output:magnetisation
output:magnetisation-length
output:mean-magnetisation-length
output:mean-specific-heat
